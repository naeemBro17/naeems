# Your Supabase project URL — found in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=your-supabase-project-url

# Your Supabase anon (public) key — found in Supabase Dashboard > Project Settings > API
# This key is safe to expose in the browser; Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Batch 40 (optional): used only when the shop cannot reach Supabase — the
# "Our online shop is being updated" page shows these two buttons. They are
# built into the site because the database may be down. Defaults are in
# src/lib/shopFallback.ts.
VITE_FALLBACK_WHATSAPP=8801560040012
VITE_FALLBACK_MESSENGER=https://m.me/naeems.skinscience
